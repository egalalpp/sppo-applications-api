# Скопируйте в .env:  cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# .env в git не попадает. Для чего-либо кроме локального запуска замените ВСЕ пароли и секреты.
# Используйте пароли из букв и цифр: так их не нужно экранировать в URL подключения.

# ---- Общее ----
ENVIRONMENT=dev
# Порт API на вашем компьютере. Фронтенд в разработке обращается к http://localhost:8000/api/v1
HTTP_PORT=8000
API_REPLICAS=2
CURRENT_PERIOD=2026-autumn
# Откуда браузеру можно вызывать API (JSON-список), например ["https://username.github.io"] для фронтенда.
# Локальный фронтенд с другого порта: ["http://localhost:5500","http://127.0.0.1:5500"]
CORS_ORIGINS=[]
# Адрес фронтенда для ссылки на личный кабинет в письмах (необязательно)
FRONTEND_URL=

# ---- MongoDB ----
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeMeRoot123
MONGO_DB=sppo
MONGO_APP_USER=sppo_app
MONGO_APP_PASSWORD=changeMeApp123

# ---- Redis (кэш + брокер Celery) ----
REDIS_PASSWORD=changeMeRedis123

# ---- JWT ----
# Не короче 32 символов. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Учётные записи ----
# Демо-учётки с известными паролями (app/seed.py):
#   student@rut.ru / student123 (студент), operator@rut.ru / operator123 (оператор), admin@rut.ru / admin123 (админ)
# Только для разработки и демонстрации. На сервере с реальными данными — false.
SEED_DEMO_USERS=true
# Первый администратор (создаётся при первом запуске, если админов ещё нет)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeMeAdmin123

# ---- S3-хранилище сканов ----
S3_ACCESS_KEY=sppoS3access
S3_SECRET_KEY=changeMeS3secret123
S3_BUCKET=sppo-docs
# По умолчанию — локальный SeaweedFS из docker-compose. Облако (например, Cloudflare R2):
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=sppo-documents
# (локальный SeaweedFS при этом можно не запускать, но он стартует по умолчанию)
S3_ENDPOINT_URL=http://s3:8333
# Адрес хранилища, каким его видит браузер (для presigned-ссылок на скачивание)
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1

# ---- Celery ----
# c из модели M/M/c/K (PD.ipynb): параллельных обработчиков распознавания и писем
CELERY_CONCURRENCY=4
# K — ёмкость очереди; при переполнении POST /submit отвечает 503
MAX_QUEUE_LENGTH=50000
# По умолчанию брокер — Redis. Для RabbitMQ: CELERY_BROKER=amqp://user:pass@rabbitmq:5672//
# (и добавить сервис rabbitmq в docker-compose.yml)
CELERY_BROKER=

# ---- Распознавание сканов (Tesseract) ----
OCR_ENABLED=true
OCR_LANG=rus+eng
# Большие фото уменьшаются до этой стороны в пикселях: быстрее и почти не влияет на точность
OCR_MAX_SIDE_PX=2000
OCR_TIMEOUT_SEC=180
# Через сколько минут зависшее распознавание можно перезапустить
OCR_STALE_MINUTES=15

# ---- Почта (письма студенту: заявка принята, одобрена, отклонена) ----
# По умолчанию письма принимает Mailpit из docker-compose: откройте http://localhost:8025
# и увидите их в браузере (удобно для скриншотов и демонстрации), наружу ничего не уходит.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="СППО РУТ (МИИТ) <noreply@sppo.local>"
# Настоящая рассылка (варианты и подробности — docs/DEPLOY.md):
#  a) Brevo по SMTP: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<логин Brevo>,
#     SMTP_PASS=<SMTP-ключ>, MAIL_FROM="СППО <подтверждённый@адрес>"
#  b) Brevo по HTTPS API (для хостингов, где SMTP закрыт, — бесплатный Render):
#     EMAIL_BACKEND=brevo, BREVO_API_KEY=<API-ключ>, MAIL_FROM="СППО <подтверждённый@адрес>"
#  c) Mailtrap (песочница с красивым ящиком): SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525, SMTP_USER и SMTP_PASS из кабинета
EMAIL_BACKEND=
SMTP_STARTTLS=
BREVO_API_KEY=

# ---- Flower (мониторинг Celery, http://localhost:5555) ----
FLOWER_USER=admin
FLOWER_PASSWORD=changeMeFlower123
