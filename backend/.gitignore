# ===== Секреты =====
# Реальные пароли и ключи живут только в .env; в репозитории — .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# ===== Данные =====
# Персональные данные (сканы, дампы БД) в git попадать не должны
data/
dumps/
backups/
*.bson
*.archive
*.gz
*.dump
uploads/
scans/
*.rdb
*.aof
appendonlydir/
docker-compose.override.yml

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
pip-wheel-metadata/

# ===== Тесты и линтеры =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# ===== Celery =====
celerybeat-schedule*
celerybeat.pid

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Логи =====
*.log
logs/

# ===== IDE и ОС =====
.idea/
.vscode/*
